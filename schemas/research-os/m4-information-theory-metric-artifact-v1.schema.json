{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-information-theory-metric-artifact.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_digest",
    "created_at",
    "git_commit",
    "working_tree_clean",
    "source_dataset_digest",
    "parent_digests",
    "preregistration_digest",
    "decision_policy_digest",
    "config_digest",
    "metric_kernel_version",
    "seed_policy",
    "unit_contract",
    "probability_epsilon",
    "issue_count",
    "issues",
    "aggregate",
    "joint_uniform_code_length",
    "bias_corrected_information_gain",
    "interpretation"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-information-theory-metric-artifact.v1"},
    "artifact_type": {"const": "descriptive_metric_artifact"},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_tree_clean": {"const": true},
    "seed_policy": {"const": "none"},
    "probability_epsilon": {"const": 0.000001},
    "issue_count": {"type": "integer", "minimum": 1},
    "bias_corrected_information_gain": {
      "type": "object",
      "properties": {
        "status": {"const": "NOT_IMPLEMENTED"},
        "eligible_for_final_pe2": {"const": false}
      },
      "required": ["status", "reason", "eligible_for_final_pe2"]
    },
    "issues": {"type": "array", "minItems": 1},
    "aggregate": {
      "type": "object",
      "required": [
        "issue_count",
        "sample_size_for_inference",
        "cumulative_observed_log_loss_gain_bits",
        "mean_observed_log_loss_gain_bits_per_issue",
        "iid_confidence_interval"
      ],
      "properties": {
        "iid_confidence_interval": {"type": "null"}
      }
    }
  },
  "additionalProperties": true
}
