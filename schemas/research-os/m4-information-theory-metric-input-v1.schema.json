{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-information-theory-metric-input.v1",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "source_dataset_digest",
    "parent_digests",
    "issues"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-information-theory-metric-input.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "source_dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_digests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "cluster_id",
          "target_vector",
          "baseline_identity",
          "baseline_probability_vector",
          "probe_probability_vector"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "cluster_id": {"type": "string", "minLength": 1},
          "baseline_identity": {"const": "NUMBER_EVENT_COMPOSITE_BASELINE"},
          "target_vector": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {"enum": [0, 1]}
          },
          "baseline_probability_vector": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "probe_probability_vector": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
