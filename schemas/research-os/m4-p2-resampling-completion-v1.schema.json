{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-p2-resampling-completion.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_digest",
    "task_id",
    "status",
    "resampling_kernel_digest",
    "resampling_run_digest",
    "requirements",
    "all_required_methods_present",
    "all_negative_controls_present",
    "all_seed_domains_separated",
    "all_cluster_invariants_passed",
    "all_smoke_replicates_complete",
    "all_artifacts_replayable",
    "mainline_execution_id",
    "state_projection_digest",
    "next_ready_task",
    "blocking_failures",
    "child_replicate_count",
    "aggregate_count",
    "engineering_progress_after",
    "evidence_progress_after",
    "eligible_for_formal_inference",
    "git_commit",
    "working_tree_clean",
    "parent_digests"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-p2-resampling-completion.v1"},
    "artifact_type": {"const": "resampling_kernel_completion"},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"const": "m4-p2-resampling"},
    "status": {"const": "COMPLETE"},
    "all_required_methods_present": {"const": true},
    "all_negative_controls_present": {"const": true},
    "all_seed_domains_separated": {"const": true},
    "all_cluster_invariants_passed": {"const": true},
    "all_smoke_replicates_complete": {"const": true},
    "all_artifacts_replayable": {"const": true},
    "state_projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "next_ready_task": {"const": "m4-p2-false-positive-and-power-runs"},
    "blocking_failures": {"type": "array", "maxItems": 0},
    "child_replicate_count": {"const": 22},
    "aggregate_count": {"const": 9},
    "engineering_progress_after": {"const": 37},
    "evidence_progress_after": {"const": 0},
    "eligible_for_formal_inference": {"const": false}
  },
  "additionalProperties": true
}
