{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-information-theory-synthetic-dataset.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_digest",
    "data_source",
    "real_dataset_reference",
    "scenario",
    "scale",
    "truth",
    "seed_policy",
    "replicate_seed",
    "issue_count",
    "draw_digest",
    "target_digest",
    "issues"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-information-theory-synthetic-dataset.v1"},
    "artifact_type": {"const": "synthetic_dataset"},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_source": {"const": "synthetic_only"},
    "real_dataset_reference": {"type": "null"},
    "issue_count": {"type": "integer", "minimum": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_index", "red_mask", "sorted_red_numbers", "target_vector"],
        "properties": {
          "issue_index": {"type": "integer", "minimum": 1},
          "red_mask": {"type": "integer", "minimum": 1, "maximum": 8589934591},
          "sorted_red_numbers": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 33}
          },
          "target_vector": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {"enum": [0, 1]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
