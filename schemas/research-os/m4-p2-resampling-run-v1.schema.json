{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-p2-resampling-run.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_digest",
    "execution_id",
    "status",
    "kernel_manifest_digest",
    "injected_signal_completion_digest",
    "truth_artifact_digests",
    "source_dataset_digests",
    "source_run_digests",
    "metric_kernel_digest",
    "walk_forward_harness_digest",
    "plan_count",
    "child_replicate_count",
    "aggregate_count",
    "plan_digests",
    "child_replicate_digests",
    "aggregate_digests",
    "all_issue_clusters_preserved",
    "all_artifacts_replayable",
    "all_seed_domains_separated",
    "eligible_for_formal_inference",
    "formal_false_positive_executed",
    "formal_power_executed",
    "mde_computed",
    "real_history_used",
    "production_checkpoint_created",
    "parent_digests"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-p2-resampling-run.v1"},
    "artifact_type": {"const": "resampling_smoke_run"},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "COMPLETE"},
    "child_replicate_count": {"const": 22},
    "aggregate_count": {"const": 9},
    "all_issue_clusters_preserved": {"const": true},
    "all_artifacts_replayable": {"const": true},
    "all_seed_domains_separated": {"const": true},
    "eligible_for_formal_inference": {"const": false},
    "formal_false_positive_executed": {"const": false},
    "formal_power_executed": {"const": false},
    "mde_computed": {"const": false},
    "real_history_used": {"const": false},
    "production_checkpoint_created": {"const": false}
  },
  "additionalProperties": true
}
