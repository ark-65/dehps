{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-information-theory-probe-state.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "probe_id",
    "probe_type",
    "training_issue_count",
    "training_row_count",
    "feature_manifest_digest",
    "preprocessing_state_digest",
    "hyperparameter_selection_digest",
    "model_parameters_digest",
    "convergence_status",
    "hyperparameters",
    "state_digest",
    "seed_policy",
    "parent_digests"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-information-theory-probe-state.v1"},
    "artifact_type": {"const": "immutable_probe_state"},
    "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "convergence_status": {
      "enum": [
        "CONVERGED",
        "CONVERGED_WITH_WARNING",
        "FAILED_CONVERGENCE",
        "INSUFFICIENT_CLASS_VARIATION",
        "INVALID_FEATURE_MATRIX"
      ]
    }
  },
  "additionalProperties": true
}
