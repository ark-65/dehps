{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dehps-m4-p2-resampling-plan.v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_digest",
    "plan_digest",
    "method",
    "source_issue_count",
    "resampled_issue_count",
    "source_indices",
    "config",
    "source_dataset_digest",
    "source_run_digest",
    "parent_digests"
  ],
  "properties": {
    "schema_version": {"const": "dehps-m4-p2-resampling-plan.v1"},
    "artifact_type": {"const": "resampling_plan"},
    "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_issue_count": {"type": "integer", "minimum": 1},
    "resampled_issue_count": {"type": "integer", "minimum": 1},
    "source_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "seed": {"type": ["integer", "null"]},
    "seed_digest": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": true
}
