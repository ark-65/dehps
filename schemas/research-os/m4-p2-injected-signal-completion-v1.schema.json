    "truth_artifact_count": {"const": 12},
    "mechanism_smoke_count": {"const": 4},
    "eligible_for_p2_5_input": {"const": true},
    "eligible_for_power_evidence": {"const": false},
    "engineering_progress_after": {"const": 34},
    "evidence_progress_after": {"const": 0},
    "next_ready_task": {"const": "m4-p2-resampling"},
    "working_tree_clean": {"const": true}
  }
}
