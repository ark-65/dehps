[Unit]
Description=DEHPS admitted independent %i execution
Requires=dehps-control-postgres@%i.service
After=dehps-control-postgres@%i.service
ConditionPathExists=/run/dehps/%i-postgres-socket/.s.PGSQL.5432

[Service]
Type=oneshot
User=dehps-%i
Group=dehps-%i
# Administrative authority is scoped to this trusted, fixed host launcher.
# No permanent account membership; Docker does not pass this host group to workers.
SupplementaryGroups=docker
Environment=PATH=/usr/bin:/bin
Environment=DOCKER_HOST=unix:///var/run/docker.sock
Environment=DOCKER_CONFIG=/opt/dehps/releases/control-refactor-r5/docker-client
EnvironmentFile=/etc/dehps/control/%i/release.env
WorkingDirectory=/opt/dehps/releases/control-refactor-r5
ExecStartPre=/usr/bin/test -S /run/dehps/%i-postgres-socket/.s.PGSQL.5432
ExecStart=/usr/bin/python3.14 -I -B /opt/dehps/releases/control-refactor-r5/launcher/launch.py run --descriptor ${DEHPS_RELEASE_DESCRIPTOR} --release-sha256 ${DEHPS_RELEASE_SHA256} --runtime-root /var/lib/dehps/control-%i --control-domain %i --inputs /opt/dehps/inputs/control-r5-%i --credentials /etc/dehps/control/%i/operator.json --network none --database-socket /run/dehps/%i-postgres-socket --action run
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/dehps/control-%i

# Deliberately no [Install] or timer: an explicit admitted task starts this entry.
