[Unit]
Description=DEHPS audited draw synchronization
Documentation=file:/home/ark/workspace/dehps/docs/architecture/continuous-research-runtime.md
Wants=network-online.target
After=network-online.target postgresql.service
Wants=dehps-forward-runtime.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=/home/ark/workspace/dehps/apps/worker-python
EnvironmentFile=-/home/ark/workspace/dehps/.env
EnvironmentFile=-/home/ark/.config/dehps/draw-sync.env
ExecStart=/home/ark/workspace/dehps/apps/worker-python/.venv/bin/python scripts/run_draw_sync_watch.py --once --no-resume-on-event --interval-seconds 900 --hot-interval-seconds 300 --cold-interval-seconds 3600 --timezone Asia/Shanghai

[Install]
WantedBy=default.target
