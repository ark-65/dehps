[Unit]
Description=DEHPS weekly M4 research progress mail
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ark/workspace/dehps/apps/worker-python
EnvironmentFile=-/home/ark/workspace/dehps/.env
EnvironmentFile=/home/ark/.config/dehps/research-progress.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ark/workspace/dehps/runtime
ExecStart=/home/ark/workspace/dehps/apps/worker-python/.venv/bin/python scripts/send_research_progress.py --deliver
