[Unit]
Description=DEHPS weekly M4 research progress mail
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ark/releases/dehps-research-progress/current/apps/worker-python
EnvironmentFile=-/home/ark/workspace/dehps/.env
EnvironmentFile=/home/ark/.config/dehps/research-progress.env
Environment=DEHPS_RESEARCH_PROGRESS_STATE_ROOT=/home/ark/workspace/dehps
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ark/workspace/dehps/runtime
ExecStart=/home/ark/workspace/dehps/apps/worker-python/.venv/bin/python /home/ark/releases/dehps-research-progress/current/apps/worker-python/scripts/send_research_progress.py --deliver
